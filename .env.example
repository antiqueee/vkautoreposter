# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_BASE_URL=http://localhost:8765
APP_HOST=127.0.0.1
APP_PORT=8765
APP_ENV=dev
LOG_LEVEL=INFO

# --- Storage ---
# Path is relative to project root. Directory must exist (or be creatable).
DB_PATH=./data/repost.db

# --- Crypto ---
# Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key separately from the DB file. Losing it = all tokens unusable.
FERNET_KEY=

# Generate once:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Used to sign session cookies. Rotating it logs everyone out.
SESSION_SECRET_KEY=

# --- VK OAuth (Standalone app) ---
# https://vk.com/editapp?act=create -> Standalone
VK_APP_ID=
VK_OAUTH_SCOPE=wall,offline
VK_API_VERSION=5.199

# --- Admin (phase 3+) ---
# HTTP Basic password for /admin. Single coordinator model.
ADMIN_PASSWORD=

# --- VK source (phase 2+) ---
# Positive group ID of the source public. Poller reads wall of -VK_SOURCE_GROUP_ID.
VK_SOURCE_GROUP_ID=
# Service token of the VK app (generated on app settings page). Used for wall.get polling.
VK_SERVICE_TOKEN=

# --- Worker tuning ---
POLL_INTERVAL_SECONDS=60
REPOST_WINDOW_SECONDS=18000
REPOST_MIN_DELAY_SECONDS=60
REPOST_LOGNORMAL_MEDIAN_SECONDS=3600
REPOST_LOGNORMAL_SIGMA=0.7
TASK_MISSED_THRESHOLD_SECONDS=21600
WORKER_BATCH_SIZE=50
